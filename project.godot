; ZERO ZONE — файл проекта Godot 4.7
config_version=5

[application]

config/name="ZERO ZONE"
config/description="Нулевая зона — атмосферный 3D survival от первого лица"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.03, 0.03, 0.035, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
ItemDB="*res://autoload/item_db.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
AudioLib="*res://autoload/audio_lib.gd"
InputRouter="*res://autoload/input_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.035, 1)
anti_aliasing/quality/msaa_3d=0

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unused_signal=0
